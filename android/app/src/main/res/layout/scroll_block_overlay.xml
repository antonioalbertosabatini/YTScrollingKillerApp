<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0B0E11"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/scroll_block_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        android:background="@drawable/scroll_block_panel_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="2dp"
            android:background="#FFFF5A3D" />

        <TextView
            android:id="@+id/scroll_block_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="-0.02"
            android:text="@string/scroll_block_title"
            android:textColor="#FFF2F0EB"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scroll_block_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/scroll_block_message"
            android:textColor="#FF9AA3AD"
            android:textSize="15sp" />

        <Button
            android:id="@+id/scroll_block_close_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/scroll_block_button_bg"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/scroll_block_close_button"
            android:textAllCaps="false"
            android:textColor="#FFF2F0EB"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
