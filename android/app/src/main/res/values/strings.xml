<resources>
    <string name="app_name">YTScrollingKiller</string>
    <string name="accessibility_service_description">Allows watching one YouTube Short in the browser. Blocks scrolling to more Shorts and closes the tab.</string>
    <string name="scroll_block_title">Scrolling blocked</string>
    <string name="scroll_block_message">You can watch this Short, but not the next one.</string>
    <string name="scroll_block_close_button">Close tab</string>
    <string name="accessibility_service_label">YTScrollingKiller Shorts Guard</string>
</resources>
